{
  "name": "payroutes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @payroutes/landing dev",
    "build:landing": "pnpm --filter @payroutes/landing build",
    "start": "pnpm --filter @payroutes/landing start",
    "lint": "pnpm --filter @payroutes/landing lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "build:packages": "pnpm --recursive --filter './packages/*' run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint-plugin-storybook": "^10.1.10",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "^8.6.15",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.15",
      "@types/react-dom": "19.2.3"
    }
  }
}
