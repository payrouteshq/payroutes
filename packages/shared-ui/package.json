{
  "name": "@payroutes/shared-ui",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "prepare": "tsup --no-dts && tailwindcss -i ./src/global.css -o ./dist/output.css --minify",
    "build": "tsup && tsc --project tsconfig.build.json && tailwindcss -i ./src/global.css -o ./dist/output.css --minify && for f in dist/index.mjs dist/index.js; do { printf '\"use client\";\\n'; cat \"$f\"; } > \"${f}.tmp\" && mv \"${f}.tmp\" \"$f\"; done",
    "build:css": "tailwindcss -i ./src/global.css -o ./dist/output.css --minify",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./src/global.css": "./src/global.css",
    "./dist/output.css": "./dist/output.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "countries-list": "^3.4.1",
    "country-flag-icons": "^1.6.20",
    "framer-motion": "^12.43.0",
    "libphonenumber-js": "^1.13.11",
    "react-syntax-highlighter": "^16.1.1",
    "react-useanimations": "^2.10.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "tailwindcss": "^4",
    "tsup": "^8",
    "typescript": "^5"
  }
}
